### Delete the old index for a clean start.

DELETE docs

### Split document texts only by whitespace.

PUT docs

{
    "mappings": {
        "properties": {
            "text_standard": {
                "type": "text",
                "analyzer": "standard"
            },
            "text": {
                "type": "text",
                "analyzer": "english"
            }
        }
    }
}

### Create a document.

POST docs/_doc/1?refresh=true

{
    "text_standard": "a book about information retrieval",
    "text": "a book about information retrieval"
}

### Search with stopwords.

POST docs/_search

{
    "query": {
        "query_string": {
            "fields": ["text_standard"],
            "query": "the book of information retrieval",
            "default_operator": "AND"
        }
    }
}

### Search without stopwords.

POST docs/_search

{
    "query": {
        "query_string": {
            "fields": ["text"],
            "query": "the book of information retrieval",
            "default_operator": "AND"
        }
    }
}

### Create stopwords edge case.

POST docs/_doc/2?refresh=true

{
    "text": "To be or not to be"
}

### Search stopwords edge case.

POST docs/_search

{
    "query": {
        "query_string": {
            "fields": ["text"],
            "query": "to be or not to be"
        }
    }
}

### Create decoy document.

POST docs/_doc/3?refresh=true

{
    "text": "A police car is here."
}

### Create relevant document.

POST docs/_doc/4?refresh=true

{
    "text": "The Police debuted in 1979."
}

### Trigger stopwords behavior.

POST docs/_search

{
    "query": {
        "query_string": {
            "fields": ["text"],
            "query": "the police",
            "default_operator": "AND"
        }
    }
}
